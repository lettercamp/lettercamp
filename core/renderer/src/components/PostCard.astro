---
import { PostCard as CustomPostCard } from '../custom-posts.js';
import { PostCard } from './layouts/resolve.jsx';
---
{CustomPostCard ? <div data-lettercamp-post-card={JSON.stringify(Astro.props)} style="display: contents"><PostCard {...Astro.props} pathname={Astro.url.pathname} client:load /></div> : <PostCard {...Astro.props} pathname={Astro.url.pathname} />}
