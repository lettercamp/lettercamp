---
import { sitePath } from '../lib/urls.js';
import SocialLink from './SocialLink.astro';
const { site } = Astro.props;
const logo = sitePath(site.logo);
const columns = (site.footer?.columns ?? []).slice(0, 4);
const socials = (site.footer?.socials ?? []).filter(({ href }) => {
  try { return typeof href === 'string' && ['https:', 'http:'].includes(new URL(href).protocol); }
  catch { return false; }
});
---

<footer class="site-footer">
  <div class:list={['footer-inner', { 'footer-has-columns': columns.length > 0 }]} style={`--footer-columns: ${Math.max(columns.length, 1)}; --footer-tablet-columns: ${Math.min(Math.max(columns.length, 1), 3)}; --footer-mobile-columns: ${Math.min(Math.max(columns.length, 1), 2)}`}>
  <div class="footer-main">
    <div class="footer-brand">
      <a class="brand" href={sitePath("/")} aria-label={`${site.name} home`}>
        {logo ? <img src={logo} width="24" height="24" alt="" /> : <span>{site.name}</span>}
      </a>
    </div>
    {columns.length > 0 && <div class="footer-columns">
      {columns.map((column, index) => <nav class="footer-column" aria-label={column.header ?? `Footer links ${index + 1}`}>
        {column.header && <h2>{column.header}</h2>}
        <ul>{(column.items ?? []).map(item => <li><a href={sitePath(item.href)}>{item.label}</a></li>)}</ul>
      </nav>)}
    </div>}
  </div>
  <div class="footer-bottom">
    {socials.length > 0 && <nav class="footer-socials" aria-label="Social links">
      {socials.map(({ platform, href }) => <SocialLink name={platform} href={href} />)}
    </nav>}
    <a class="footer-credit" href="https://lettercamp.com">Made with <strong>Lettercamp</strong></a>
  </div>
  </div>
</footer>
