---
import PostCard from './PostCard.astro';
const { posts, site } = Astro.props;
---

{posts.length > 0 && <section class="related-posts" aria-labelledby="related-posts-heading" hidden={site.post?.showRelatedPosts === false}>
  <h2 id="related-posts-heading">Related</h2>
  <div class="post-list">
    {posts.map(post => <PostCard post={post} site={site} />)}
  </div>
</section>}
