---
import { resolveAuthors } from '../lib/authors.js';
import { sitePath } from '../lib/urls.js';
const { post, site, variant = 'article', date = post.date } = Astro.props;
const authors = resolveAuthors(post).filter(author => author.name.trim()).map(author => ({ ...author, image: sitePath(author.image) }));
const portraits = authors.filter(author => author.image);
const showReadingTime = variant === 'article' && site.post?.showReadingTime !== false && typeof post.readingMinutes === 'number';
const showDate = date?.label;
---

{(authors.length > 0 || showReadingTime || showDate) && <div class="post-byline">
  {showDate && <time datetime={date.iso}>{date.label}</time>}
  {authors.length > 0 && <span class="post-authors">
    {portraits.length > 0 && <span class="author-portraits" aria-hidden="true">
      {portraits.map(author => <span class="author-portrait" title={author.name}>
        <img class="author-avatar" src={author.image} width="24" height="24" alt="" loading="lazy" />
      </span>)}
    </span>}
    <span class="author-names">
      <span class="author-names-desktop">
      {authors.length <= 2 ? authors.map(author => author.name).join(', ') : <>
        {authors.slice(0, 2).map(author => author.name).join(', ')}{' '}
        <button type="button" class="author-more" aria-haspopup="dialog" data-authors={JSON.stringify(authors)}>+ {authors.length - 2} more</button>
        <span class="sr-only">{': ' + authors.slice(2).map(author => author.name).join(', ')}</span>
      </>}
      </span>
      <span class="author-names-mobile">
        <span class="author-name" title={authors[0].name}>{authors[0].name}</span>
        {authors.length > 1 && <button type="button" class="author-more" aria-haspopup="dialog" data-authors={JSON.stringify(authors)}>+ {authors.length - 1} more {authors.length === 2 ? 'author' : 'authors'}</button>}
      </span>
    </span>
  </span>}
  {showReadingTime && <span class="reading-time">{post.readingMinutes} min read</span>}
</div>}
