---
import ListingPage from '../../components/layouts/ListingPage.astro';
import { getCategories } from '../../lib/posts.js';
export function getStaticPaths() {
  return getCategories().map(category => ({ params: { tag: category.tag }, props: { category: category.name } }));
}
const { category } = Astro.props;
---
<ListingPage category={category} />
