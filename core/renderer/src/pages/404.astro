---
import site from '../site.js';
import { sitePath } from '../lib/urls.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found</title>
    <style>
      html {
        color-scheme: light;
        background: #fff;
        color: #222;
        font-family: system-ui, sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        box-sizing: border-box;
        display: grid;
        min-height: 100vh;
        min-height: 100dvh;
        place-items: center;
        padding: 24px;
        text-align: center;
      }

      .message {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .logo {
        display: block;
        width: 40px;
        height: 40px;
        margin: 0 0 16px;
      }

      h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.5;
      }

      p {
        margin: 2px 0 0;
        color: #777;
        font-size: 14px;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="message">
        {site.logo && <img class="logo" src={sitePath(site.logo)} width="40" height="40" alt={site.name} />}
        <h1>404</h1>
        <p>Page Not Found</p>
      </div>
    </main>
  </body>
</html>
