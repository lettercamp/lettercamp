---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PostLayout as CustomPostLayout } from '../custom-posts.js';
import { PostLayout } from '../components/layouts/resolve.jsx';
import PostBody from '../components/PostBody.astro';
import DefaultPostLayout from '../components/layouts/PostLayout.astro';
import { pageSlug, postDate, getCategories, getPosts } from '../lib/posts.js';
import { createRelatedPostSelector } from '../lib/related-posts';
import { sitePath } from '../lib/urls.js';
import site from '../site.js';
import { pages } from '../content.js';

export function getStaticPaths() {
  const posts = getPosts(site.language, site.timeZone);
  const selectRelated = createRelatedPostSelector(posts, site.language);
  const byHref = new Map(posts.map(post => [post.href, post]));
  return Object.entries(pages).map(([filename, page]) => {
    const slug = pageSlug(filename);
    const href = sitePath(`/${slug.split('/').map(encodeURIComponent).join('/')}`);
    return { params: { slug }, props: { page, relatedPosts: selectRelated(byHref.get(href)) } };
  });
}

const { page, relatedPosts } = Astro.props;
const { Content, frontmatter = {} } = page;
const coverImage = sitePath(frontmatter.image ?? frontmatter.ogImage);
const headings = (page.getHeadings?.() ?? []).filter(({ depth }) => depth === 2 || depth === 3);
const category = typeof frontmatter.category === 'string' ? frontmatter.category.trim() : '';
const categoryHref = getCategories().find(item => item.name === category)?.href;
const date = postDate(frontmatter.date, site.language, site.timeZone);
const postLayout = site.post ?? {};
const post = { ...frontmatter, title: frontmatter.title ?? site.name, category, categoryHref, date, href: Astro.url.pathname };
const layoutProps = { site, post, headings, relatedPosts, pathname: Astro.url.pathname };
---

<SiteLayout site={site} page={frontmatter} article priorityImage={postLayout.showCover !== false && frontmatter.showCover !== false ? coverImage : undefined} themePreview={{ kind: 'post', props: { post, headings, relatedPosts } }}>
  {CustomPostLayout ? <PostLayout {...layoutProps} client:load><PostBody site={site}><Content /></PostBody></PostLayout> : <DefaultPostLayout {...layoutProps}><Content /></DefaultPostLayout>}
</SiteLayout>
