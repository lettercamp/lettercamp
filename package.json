{
  "name": "lettercamp-workspace",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "wrapper",
    "create"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include \"core/src/**/*.ts\" --include \"core/renderer/**/*\" scripts/dev.ts",
    "build": "npm run build --workspace @lettercamp/cli",
    "starter:optimize": "tsx scripts/optimize-starter.ts",
    "check": "npm run check --workspace @lettercamp/cli && tsc --project scripts/tsconfig.json && node --check wrapper/bin/lettercamp.js && node --check create/bin/create-lettercamp.js",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "release:publish": "tsx scripts/publish.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "semver": "^7.7.3",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
